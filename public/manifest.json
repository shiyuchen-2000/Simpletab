{
  "manifest_version": 3,
  "name": "SimpleTab 简页",
  "version": "1.4.0",
  "description": "无广告、简洁好用的浏览器起始页：时钟、搜索、快捷链接、壁纸主题，基础功能一应俱全",
  "author": "史宇辰",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.gstatic.cn/*",
    "https://favicon.yandex.net/*",
    "https://favicon.im/*",
    "https://icons.duckduckgo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
