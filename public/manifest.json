{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "1.4.0",
  "default_locale": "zh_CN",
  "description": "__MSG_extension_description__",
  "author": "史宇辰",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.gstatic.cn/*",
    "https://favicon.yandex.net/*",
    "https://favicon.im/*",
    "https://icons.duckduckgo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
